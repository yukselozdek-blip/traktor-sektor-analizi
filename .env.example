# ===== DATABASE =====
# PostgreSQL connection string (format: postgresql://user:password@host:port/database)
DATABASE_URL=postgresql://traktor:CHANGE_ME@localhost:5432/traktorsektordb
# PostgreSQL user (used in docker-compose)
POSTGRES_USER=traktor
# PostgreSQL password - CHANGE THIS in production (used in docker-compose)
POSTGRES_PASSWORD=CHANGE_ME
# PostgreSQL database name
POSTGRES_DB=traktorsektordb

# ===== APPLICATION CORE =====
# Environment: development, production, staging
NODE_ENV=development
# Server port
PORT=3000
# JWT secret for token signing - REQUIRED, generate with: openssl rand -hex 48
JWT_SECRET=02913f7cef6614dca4cf1d23cda281572372042831bae3b013a703426b4ee90afb3e924226d481c6f19f4bcd63325ed8
# Application base URL (used for email links, OAuth redirects, etc.)
APP_BASE_URL=https://your-railway-app.up.railway.app
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,https://your-railway-app.up.railway.app
# Comma-separated list of superuser email addresses
SUPERUSER_EMAILS=admin@example.com

# ===== WHATSAPP INTEGRATION =====
# WhatsApp webhook verification token
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
# WhatsApp Business API access token
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
# WhatsApp Business phone number ID
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
# WhatsApp Business account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME
# Internal WhatsApp query API key
WHATSAPP_QUERY_API_KEY=CHANGE_ME
# WhatsApp app secret for webhook signature verification
WHATSAPP_APP_SECRET=CHANGE_ME
# n8n WhatsApp processor webhook URL
N8N_WHATSAPP_PROCESSOR_URL=https://your-n8n-service.up.railway.app/webhook/whatsapp-sales-assistant-process-v4
# n8n model intelligence webhook URL
N8N_MODEL_INTEL_WEBHOOK_URL=https://your-n8n-service.up.railway.app/webhook/model-intelligence

# ===== MEDIA WATCH BRIDGE =====
MEDIA_WATCH_WEBHOOK_KEY=CHANGE_ME
MEDIA_WATCH_N8N_WEBHOOK_URL=http://127.0.0.1:5680/webhook/media-watch-pack-1
MEDIA_WATCH_N8N_WEBHOOK_URL_PACK_2=http://127.0.0.1:5680/webhook/media-watch-pack-2
MEDIA_WATCH_N8N_WEBHOOK_URL_PACK_3=http://127.0.0.1:5680/webhook/media-watch-pack-3
MEDIA_WATCH_BRIDGE_PORT=3011
MEDIA_WATCH_BRIDGE_HOST=127.0.0.1
MEDIA_WATCH_BRIDGE_AUTORUN=true
MEDIA_WATCH_BRIDGE_SCHEDULE=*/30 * * * *
MEDIA_WATCH_BRIDGE_PACKS=pack-1,pack-2,pack-3
# DIRECT MODE: n8n'i bypass et, doğrudan app'in /api/media-watch/ingest'ine POST at (varsayılan: true)
MEDIA_WATCH_BRIDGE_DIRECT=true
# Bridge'in app'e ulaşacağı base URL (lokal: http://127.0.0.1:3002, Docker: http://app:3000, Railway: https://your-app.up.railway.app)
MEDIA_WATCH_APP_BASE_URL=http://127.0.0.1:3002
# Server.js bridge'i child_process olarak otomatik başlatsın (lokal kolaylık)
MEDIA_WATCH_BRIDGE_AUTOSTART=true

# ===== MODEL IMAGE BRIDGE (Marka Merkezi görsel doğrulama servisi) =====
MODEL_IMAGE_BRIDGE_URL=http://127.0.0.1:3012
MODEL_IMAGE_BRIDGE_PORT=3012
MODEL_IMAGE_BRIDGE_HOST=127.0.0.1
MODEL_IMAGE_BRIDGE_AUTORUN=false
MODEL_IMAGE_BRIDGE_SCHEDULE=0 */6 * * *
MODEL_IMAGE_BRIDGE_BATCH=12
MODEL_IMAGE_BRIDGE_TIMEOUT_MS=15000
MODEL_IMAGE_BRIDGE_DELAY_MS=1200
N8N_MODEL_IMAGE_WEBHOOK_URL=http://127.0.0.1:5680/webhook/model-image-crawler

# ===== SEARCH & VISION (görsel arama + AI doğrulama) =====
BING_SEARCH_API_KEY=CHANGE_ME
BRAVE_SEARCH_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# ===== N8N WORKFLOW ENGINE (separate Railway service) =====
N8N_BASIC_AUTH_USER=admin
# n8n admin password - CHANGE THIS in production
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://your-n8n-service.up.railway.app
WEBHOOK_URL=https://your-n8n-service.up.railway.app/
N8N_SECURE_COOKIE=true
# n8n encryption key for storing credentials - CHANGE THIS in production
N8N_ENCRYPTION_KEY=CHANGE_ME
GENERIC_TIMEZONE=Europe/Istanbul
TZ=Europe/Istanbul
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=your-railway-postgres-host
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=railway
DB_POSTGRESDB_USER=postgres
# n8n PostgreSQL password - CHANGE THIS in production
DB_POSTGRESDB_PASSWORD=CHANGE_ME
DB_POSTGRESDB_SCHEMA=n8n

# ===== ANYTHINGLLM =====
ANYTHINGLLM_API_KEY=CHANGE_ME
ANYTHINGLLM_HOST=localhost
ANYTHINGLLM_PORT=3001

# ===== AI / LLM PROVIDERS =====
OPENAI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
MINIMAX_API_KEY=CHANGE_ME
INSIGHTS_API_KEY=CHANGE_ME

# ===== GOOGLE OAUTH (Sign-in with Google) =====
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# ===== PAYMENT - Stripe (uluslararası kart) =====
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_PUBLISHABLE_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# ===== PAYMENT - iyzico (Türkiye yerel kart) =====
IYZICO_API_KEY=CHANGE_ME
IYZICO_SECRET_KEY=CHANGE_ME
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ===== PAYMENT - Banka havalesi (manuel onay) =====
BANK_TRANSFER_BANK=Garanti BBVA
BANK_TRANSFER_HOLDER=Traktör Sektör Analizi A.Ş.
BANK_TRANSFER_IBAN=CHANGE_ME
BANK_TRANSFER_SWIFT=TGBATRIS

# ===== WEATHER API =====
OPENWEATHERMAP_API_KEY=CHANGE_ME
